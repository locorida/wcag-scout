#!/usr/bin/env php
<?php

declare(strict_types=1);

use WcagScout\Cli\Application;

$autoload = dirname(__DIR__) . '/vendor/autoload.php';
if (!is_file($autoload)) {
    fwrite(STDERR, "Dependencies are missing. Run: composer install\n");
    exit(3);
}
require $autoload;

// Report times use the TZ environment variable (e.g. docker run -e TZ=Europe/Berlin), else UTC.
$timezone = getenv('TZ');
date_default_timezone_set(is_string($timezone) && in_array($timezone, timezone_identifiers_list(), true) ? $timezone : 'UTC');

exit(new Application()->run());
